# Communication Center V15 - provider-neutral webhooks
MESSAGE_SMS_WEBHOOK_URL=
WHATSAPP_MESSAGE_WEBHOOK_URL=
PUSH_MESSAGE_WEBHOOK_URL=
MESSAGE_WEBHOOK_TOKEN=

# Firebase Cloud Messaging V4
FCM_ENABLED=false
FIREBASE_PROJECT_ID=
# Store this only as a Cloudflare secret. Paste the service-account JSON as one-line JSON.
FIREBASE_SERVICE_ACCOUNT_JSON=
FCM_WORKERS=2

# V59 separated frontend (comma-separated exact origins)
FRONTEND_ORIGINS=https://student.ragab-seddik.com
FRONTEND_PRIMARY_ORIGIN=https://student.ragab-seddik.com

# V79 production runtime tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
WEB_CONCURRENCY=1
UVICORN_KEEPALIVE_SECONDS=5
UVICORN_BACKLOG=2048
LOG_LEVEL=INFO
REDIS_RETRY_SECONDS=5
FORWARDED_ALLOW_IPS=*
