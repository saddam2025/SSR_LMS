ENV=production
APP_SECRET=REPLACE_WITH_64_PLUS_RANDOM_CHARACTERS
PUBLIC_BASE_URL=https://ragab-seddik.com
ALLOWED_HOSTS=ragab-seddik.com,www.ragab-seddik.com,healthcheck.railway.app
TRUST_PROXY_HEADERS=true
HSTS_INCLUDE_SUBDOMAINS=false
HSTS_PRELOAD=false
DATABASE_URL=REPLACE_WITH_MANAGED_POSTGRES_URL
REDIS_URL=REPLACE_WITH_MANAGED_REDIS_URL
ADMIN_NAME=مدير منصة المستشار
ADMIN_EMAIL=REPLACE_WITH_ADMIN_EMAIL
ADMIN_PASSWORD=REPLACE_WITH_STRONG_UNIQUE_PASSWORD
REQUIRE_STAFF_MFA=true
MAX_DEVICES_PER_USER=2
STUDENT_SINGLE_SESSION=true
SESSION_IDLE_MINUTES=45
SESSION_ABSOLUTE_HOURS=24
SESSION_TOUCH_SECONDS=180
VIDEO_ALLOWED_HOSTS=cloudflarestream.com,videodelivery.net
ALLOW_DIRECT_VIDEO_PROXY=false
VIDEO_TOKEN_TTL_SECONDS=7200
CLOUDFLARE_DEPLOYMENT=true
CF_EDGE_SIGNING_SECRET=REPLACE_WITH_A_DIFFERENT_32_PLUS_CHARACTER_SECRET
CF_STREAM_CUSTOMER_CODE=REPLACE_WITH_STREAM_CUSTOMER_CODE
STREAM_EDGE_GRANT_TTL_SECONDS=90
STREAM_ALLOWED_ORIGINS=ragab-seddik.com,www.ragab-seddik.com
CF_ACCOUNT_ID=
CF_STREAM_API_TOKEN=
CF_STREAM_MAX_UPLOAD_BYTES=32212254720
CF_STREAM_TUS_CHUNK_BYTES=10485760
CF_STREAM_MAX_DURATION_SECONDS=21600
RUN_SEED_ON_START=false
RUN_STARTUP_PREFLIGHT=false
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
DIRECT_R2_UPLOAD_ENABLED=true
DIRECT_R2_UPLOAD_TTL_SECONDS=1200
STORAGE_PREFLIGHT_ROUNDTRIP=false
S3_MAX_POOL_CONNECTIONS=32
S3_UPLOAD_CONCURRENCY=4
S3_CONNECT_TIMEOUT_SECONDS=5
S3_READ_TIMEOUT_SECONDS=90
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID=
OTP_SMS_WEBHOOK_URL=
OTP_SMS_WEBHOOK_TOKEN=
DRM_PROVIDER=
DRM_LICENSE_SERVER_URL=
OFFLINE_DRM_LICENSE_URL=

# Communication Center V15 - provider-neutral webhooks
MESSAGE_SMS_WEBHOOK_URL=
WHATSAPP_MESSAGE_WEBHOOK_URL=
PUSH_MESSAGE_WEBHOOK_URL=
MESSAGE_WEBHOOK_TOKEN=

# Firebase Cloud Messaging V4
FCM_ENABLED=false
FIREBASE_PROJECT_ID=
# Store this only as a Cloudflare secret. Paste the service-account JSON as one-line JSON.
FIREBASE_SERVICE_ACCOUNT_JSON=
FCM_WORKERS=2

# Normal single-domain deployment (recommended).
SEPARATED_FRONTEND_ENABLED=false
FRONTEND_ORIGINS=
FRONTEND_PRIMARY_ORIGIN=

# V79 production runtime tuning
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
WEB_CONCURRENCY=2
UVICORN_KEEPALIVE_SECONDS=5
UVICORN_BACKLOG=2048
LOG_LEVEL=INFO
REDIS_RETRY_SECONDS=5
PREFLIGHT_RETRIES=18
PREFLIGHT_RETRY_SECONDS=3
FORWARDED_ALLOW_IPS=*

# Durable Redis-stream background tasks
TASK_WORKER_MODE=embedded
TASK_MAX_ATTEMPTS=3
TASK_CLAIM_IDLE_MS=60000

WATERMARK_MAX_CONCURRENT=2
WATERMARK_ACQUIRE_TIMEOUT_SECONDS=5
