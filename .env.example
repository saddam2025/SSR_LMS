CF_EDGE_SIGNING_SECRET=REPLACE_WITH_A_DIFFERENT_32_PLUS_CHARACTER_SECRET
CF_STREAM_CUSTOMER_CODE=
CF_ACCOUNT_ID=
CF_STREAM_API_TOKEN=
CF_STREAM_MAX_UPLOAD_BYTES=32212254720
CF_STREAM_TUS_CHUNK_BYTES=10485760
CF_STREAM_MAX_DURATION_SECONDS=21600
RUN_SEED_ON_START=false
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
