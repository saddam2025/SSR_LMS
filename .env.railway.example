# Mostashar V96 - Railway production/staging template
# IMPORTANT: use ENV=production even on Staging so production safety gates run.
ENV=production
APP_SECRET=REPLACE_WITH_64_PLUS_RANDOM_CHARACTERS
PUBLIC_BASE_URL=https://ragab-seddik.com
ALLOWED_HOSTS=ragab-seddik.com,www.ragab-seddik.com,healthcheck.railway.app
TRUST_PROXY_HEADERS=true
HSTS_INCLUDE_SUBDOMAINS=false
HSTS_PRELOAD=false
FORWARDED_ALLOW_IPS=*

# Railway reference variables - use Railway UI autocomplete.
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}

ADMIN_NAME=مدير منصة المستشار
ADMIN_EMAIL=REPLACE_WITH_ADMIN_EMAIL
ADMIN_PASSWORD=REPLACE_WITH_STRONG_UNIQUE_14_PLUS_PASSWORD
REQUIRE_STAFF_MFA=true
MAX_DEVICES_PER_USER=2
STUDENT_SINGLE_SESSION=true
SESSION_IDLE_MINUTES=45
SESSION_ABSOLUTE_HOURS=24
SESSION_TOUCH_SECONDS=180

# Frontend mode. Keep false for the normal single-domain Railway deployment.
# Enable only after a separate student frontend is actually deployed and tested.
SEPARATED_FRONTEND_ENABLED=false
FRONTEND_ORIGINS=
FRONTEND_PRIMARY_ORIGIN=

# Cloudflare deployment
CLOUDFLARE_DEPLOYMENT=true
CF_EDGE_SIGNING_SECRET=REPLACE_WITH_DIFFERENT_32_PLUS_RANDOM_CHARACTERS
VIDEO_ALLOWED_HOSTS=cloudflarestream.com,videodelivery.net
ALLOW_DIRECT_VIDEO_PROXY=false
VIDEO_TOKEN_TTL_SECONDS=7200
CF_ACCOUNT_ID=REPLACE_WITH_32_CHAR_ACCOUNT_ID
CF_STREAM_API_TOKEN=REPLACE_WITH_SCOPED_STREAM_TOKEN
CF_STREAM_CUSTOMER_CODE=REPLACE_WITH_STREAM_CUSTOMER_CODE
STREAM_EDGE_GRANT_TTL_SECONDS=90
STREAM_ALLOWED_ORIGINS=ragab-seddik.com,www.ragab-seddik.com
CF_STREAM_MAX_UPLOAD_BYTES=32212254720
CF_STREAM_TUS_CHUNK_BYTES=10485760
CF_STREAM_MAX_DURATION_SECONDS=21600

# R2 private storage
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=https://REPLACE_ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=REPLACE_WITH_PRIVATE_BUCKET_NAME
S3_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_KEY
DIRECT_R2_UPLOAD_ENABLED=true
DIRECT_R2_UPLOAD_TTL_SECONDS=1200
S3_MAX_POOL_CONNECTIONS=32
S3_UPLOAD_CONCURRENCY=4
S3_CONNECT_TIMEOUT_SECONDS=5
S3_READ_TIMEOUT_SECONDS=90

# Payments - keep blank/disabled until Paymob test acceptance succeeds
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID=

# OTP / communications - optional
OTP_SMS_WEBHOOK_URL=
OTP_SMS_WEBHOOK_TOKEN=
MESSAGE_SMS_WEBHOOK_URL=
WHATSAPP_MESSAGE_WEBHOOK_URL=
PUSH_MESSAGE_WEBHOOK_URL=
MESSAGE_WEBHOOK_TOKEN=

# Firebase Cloud Messaging - optional
FCM_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
FCM_WORKERS=2

# Runtime tuning
WATERMARK_MAX_CONCURRENT=2
WATERMARK_ACQUIRE_TIMEOUT_SECONDS=5
RUN_SEED_ON_START=false
# Railway uses app.deploy_prepare as pre-deploy; keep false on Railway.
RUN_STARTUP_PREFLIGHT=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
WEB_CONCURRENCY=2
UVICORN_KEEPALIVE_SECONDS=5
UVICORN_BACKLOG=2048
LOG_LEVEL=INFO
REDIS_RETRY_SECONDS=5
# Railway startup/healthcheck hardening
# Railway injects PORT automatically; do not hardcode PORT in the app.
PREFLIGHT_RETRIES=18
PREFLIGHT_RETRY_SECONDS=3
STORAGE_PREFLIGHT_ROUNDTRIP=false
RAILWAY_HEALTHCHECK_TIMEOUT_SEC=300

# Durable Redis-stream background tasks
TASK_WORKER_MODE=embedded
TASK_MAX_ATTEMPTS=3
TASK_CLAIM_IDLE_MS=60000
