# Mostashar V89 - Railway production/staging template
# IMPORTANT: use ENV=production even on Staging so production safety gates run.
ENV=production
APP_SECRET=REPLACE_WITH_64_PLUS_RANDOM_CHARACTERS
PUBLIC_BASE_URL=https://api.ragab-seddik.com
ALLOWED_HOSTS=api.ragab-seddik.com,ragab-seddik.com,www.ragab-seddik.com,healthcheck.railway.app
TRUST_PROXY_HEADERS=true
FORWARDED_ALLOW_IPS=*

# Railway reference variables - use Railway UI autocomplete.
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}

ADMIN_NAME=مدير منصة المستشار
ADMIN_EMAIL=REPLACE_WITH_ADMIN_EMAIL
ADMIN_PASSWORD=REPLACE_WITH_STRONG_UNIQUE_14_PLUS_PASSWORD
REQUIRE_STAFF_MFA=true
MAX_DEVICES_PER_USER=2
STUDENT_SINGLE_SESSION=true
SESSION_IDLE_MINUTES=45
SESSION_ABSOLUTE_HOURS=24
SESSION_TOUCH_SECONDS=60

# Frontend / CORS
FRONTEND_ORIGINS=https://student.ragab-seddik.com
FRONTEND_PRIMARY_ORIGIN=https://student.ragab-seddik.com

# Cloudflare deployment
CLOUDFLARE_DEPLOYMENT=true
CF_EDGE_SIGNING_SECRET=REPLACE_WITH_DIFFERENT_32_PLUS_RANDOM_CHARACTERS
VIDEO_ALLOWED_HOSTS=cloudflarestream.com,videodelivery.net
ALLOW_DIRECT_VIDEO_PROXY=false
VIDEO_TOKEN_TTL_SECONDS=7200
CF_ACCOUNT_ID=REPLACE_WITH_32_CHAR_ACCOUNT_ID
CF_STREAM_API_TOKEN=REPLACE_WITH_SCOPED_STREAM_TOKEN
CF_STREAM_CUSTOMER_CODE=REPLACE_WITH_STREAM_CUSTOMER_CODE
CF_STREAM_MAX_UPLOAD_BYTES=32212254720
CF_STREAM_TUS_CHUNK_BYTES=10485760
CF_STREAM_MAX_DURATION_SECONDS=21600

# R2 private storage
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=https://REPLACE_ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=REPLACE_WITH_PRIVATE_BUCKET_NAME
S3_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_KEY

# Payments - keep blank/disabled until Paymob test acceptance succeeds
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID=

# OTP / communications - optional
OTP_SMS_WEBHOOK_URL=
OTP_SMS_WEBHOOK_TOKEN=
MESSAGE_SMS_WEBHOOK_URL=
WHATSAPP_MESSAGE_WEBHOOK_URL=
PUSH_MESSAGE_WEBHOOK_URL=
MESSAGE_WEBHOOK_TOKEN=

# Firebase Cloud Messaging - optional
FCM_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
FCM_WORKERS=2

# Runtime tuning
RUN_SEED_ON_START=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
WEB_CONCURRENCY=1
UVICORN_KEEPALIVE_SECONDS=5
UVICORN_BACKLOG=2048
LOG_LEVEL=INFO
REDIS_RETRY_SECONDS=5
