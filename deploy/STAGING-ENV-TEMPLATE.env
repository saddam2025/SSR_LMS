# Mostashar V83 staging environment template.
# Copy to a private file OUTSIDE source control and replace all REPLACE_* values.
ENV=production
APP_SECRET=REPLACE_WITH_STAGING_64_PLUS_RANDOM_CHARACTERS
PUBLIC_BASE_URL=https://staging-api.ragab-seddik.com
ALLOWED_HOSTS=staging-api.ragab-seddik.com
TRUST_PROXY_HEADERS=true
DATABASE_URL=REPLACE_WITH_STAGING_POSTGRES_URL
REDIS_URL=REPLACE_WITH_STAGING_REDIS_URL
ADMIN_NAME=مدير منصة المستشار - Staging
ADMIN_EMAIL=REPLACE_WITH_STAGING_ADMIN_EMAIL
ADMIN_PASSWORD=REPLACE_WITH_STAGING_STRONG_UNIQUE_PASSWORD
REQUIRE_STAFF_MFA=true
MAX_DEVICES_PER_USER=2
STUDENT_SINGLE_SESSION=true
SESSION_IDLE_MINUTES=45
SESSION_ABSOLUTE_HOURS=24
VIDEO_ALLOWED_HOSTS=cloudflarestream.com,videodelivery.net
ALLOW_DIRECT_VIDEO_PROXY=false
VIDEO_TOKEN_TTL_SECONDS=7200
CLOUDFLARE_DEPLOYMENT=true
CF_EDGE_SIGNING_SECRET=REPLACE_WITH_STAGING_DIFFERENT_32_PLUS_CHARACTER_SECRET
CF_STREAM_CUSTOMER_CODE=REPLACE_WITH_STAGING_STREAM_CUSTOMER_CODE
CF_ACCOUNT_ID=REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID
CF_STREAM_API_TOKEN=REPLACE_WITH_STAGING_SCOPED_STREAM_TOKEN
CF_STREAM_MAX_UPLOAD_BYTES=32212254720
CF_STREAM_TUS_CHUNK_BYTES=10485760
CF_STREAM_MAX_DURATION_SECONDS=21600
RUN_SEED_ON_START=false
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=REPLACE_WITH_STAGING_R2_HTTPS_ENDPOINT
S3_REGION=auto
S3_BUCKET=REPLACE_WITH_STAGING_R2_BUCKET
S3_ACCESS_KEY_ID=REPLACE_WITH_STAGING_R2_ACCESS_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_STAGING_R2_SECRET_KEY
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID=
FCM_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
FRONTEND_ORIGINS=https://staging-student.ragab-seddik.com
FRONTEND_PRIMARY_ORIGIN=https://staging-student.ragab-seddik.com
DB_POOL_SIZE=4
DB_MAX_OVERFLOW=4
DB_POOL_TIMEOUT=15
DB_POOL_RECYCLE=1800
WEB_CONCURRENCY=1
UVICORN_KEEPALIVE_SECONDS=5
UVICORN_BACKLOG=2048
LOG_LEVEL=INFO
REDIS_RETRY_SECONDS=5
FORWARDED_ALLOW_IPS=*
